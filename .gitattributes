# 仓库内统一存 LF，检出到工作区时按下面的规则转换
* text=auto eol=lf

# ---------- C/C++ 源码 ----------
*.c          text eol=lf
*.h          text eol=lf
*.cc         text eol=lf
*.cpp        text eol=lf
*.cxx        text eol=lf
*.hpp        text eol=lf
*.hxx        text eol=lf
*.inl        text eol=lf

# ---------- 构建与配置 ----------
*.cmake          text eol=lf
CMakeLists.txt   text eol=lf
CMakePresets.json text eol=lf
*.json           text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.conf           text eol=lf
*.ini            text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf
.editorconfig    text eol=lf
.clang-format    text eol=lf
.clang-tidy      text eol=lf
*.md             text eol=lf
*.txt            text eol=lf

# Windows 批处理必须是 CRLF，cmd 解析标签对 LF 不友好
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ---------- 二进制：不做换行转换，也不做文本 diff ----------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.gif   binary
*.exe   binary
*.dll   binary
*.lib   binary
*.pdb   binary
*.zip   binary

# ---------- 第三方 vendored 代码 ----------
# 让 GitHub 不把 external/ 计入本仓库的语言统计，也避免 diff 里出现大量噪音
external/** linguist-vendored

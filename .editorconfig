root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

[*.{md,markdown,json,yml,yaml}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.cmake]
indent_style = space
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.txt]
trim_trailing_whitespace = false

# vendor 的第三方源码保持原样，不要被编辑器自动整理
[external/**]
indent_style = unset
indent_size = unset
tab_width = unset
trim_trailing_whitespace = false
insert_final_newline = unset
